{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/favicon.svg", "destination": "/public/favicon.svg" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/admin.html", "destination": "/public/admin.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
